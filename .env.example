# Copia este archivo como .env (local) o define las variables en Vercel / Netlify.

# Dominio definitivo, sin diagonal final. Se usa en canonical, sitemap, OG y schema.
PUBLIC_SITE_URL=https://connexis.mx

# Google Analytics 4 · ID de medición (Administrar > Flujos de datos > Web)
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Search Console · solo el valor "content" de la etiqueta HTML de verificación
PUBLIC_GSC_VERIFICATION=

# Google Ads (opcional) · conversión registrada en /gracias
PUBLIC_GADS_ID=AW-XXXXXXXXX
PUBLIC_GADS_CONVERSION_LABEL=

# Formularios
# - En Netlify déjalo vacío: se usa Netlify Forms automáticamente.
# - En Vercel (u otro host) pon el endpoint de Formspree, Web3Forms, Basin, etc.
PUBLIC_FORM_ENDPOINT=
