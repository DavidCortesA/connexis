---
// Intención de búsqueda: comercial-local ("redes de comunicaciones / soluciones tecnológicas para empresas en Monterrey").
// El primer párrafo responde QUÉ hace ConneXis, PARA QUIÉN y DÓNDE, con CTA visible sin scroll.
// Enfoque: redes primero, después ciberseguridad y seguridad electrónica (pedido del cliente, nov 2026).
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Radar from '../components/Radar.astro';
import Marquee from '../components/Marquee.astro';
import Photo from '../components/Photo.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE, whatsappUrl, fullAddress, socialLinks } from '../data/site';
import { services } from '../data/services';
// ETAPA 2 · Casos de éxito / ETAPA 3 · Blog (fuera de alcance en la Etapa 1)
// import { cases } from '../data/cases.mjs';
// import { posts } from '../data/posts';
// import { getService } from '../data/services';

// ETAPA 2 · Filtros de proyectos
// const filters = [
//   { key: 'todos', label: 'Todos' },
//   { key: 'redes-empresariales', label: 'Redes' },
//   { key: 'ciberseguridad', label: 'Ciberseguridad' },
//   { key: 'seguridad-electronica', label: 'Seguridad electrónica' },
// ];
---
<BaseLayout
  title="Redes, ciberseguridad y seguridad electrónica | ConneXis"
  description="Soluciones tecnológicas para empresas en Monterrey: redes de comunicaciones, ciberseguridad y seguridad electrónica para conectar y proteger su negocio."
  shareTitle="ConneXis · Tecnología para conectar, proteger y fortalecer su empresa"
  mobileCta={{ href: '#contacto', label: 'Contactar' }}
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__copy" data-hero>
        <p class="eyebrow">Soluciones tecnológicas empresariales</p>
        <h1 id="hero-title">Tecnología para conectar, proteger y <span class="hl">fortalecer su empresa</span></h1>
        <p class="lead">Ofrecemos soluciones empresariales en redes e infraestructura de comunicaciones, ciberseguridad y seguridad electrónica.</p>
        <div class="btn-row">
          <a class="btn" href="#servicios" data-track="cta_click" data-track-loc="hero">Conocer nuestros servicios <Icon name="ArrowRight" class="i-arrow" /></a>
          <a class="btn btn--light" href="#contacto" data-track="cta_click" data-track-loc="hero-contacto">Contactar a ConneXis</a>
        </div>
        <ul class="hero__proof">
          <li><Icon name="MapPin" size={16} /> Atención en sitio en Monterrey</li>
          <li><Icon name="Building2" size={16} /> Especialistas en PyMEs</li>
        </ul>
      </div>
      <div class="hero__radar" data-hero-art>
        <Radar />
      </div>
    </div>
  </section>

  <Marquee label="Soluciones" items={['Redes y Wi‑Fi', 'Segmentación de red', 'Cableado estructurado', 'Fibra óptica', 'Firewall perimetral', 'Prevención de intrusos (IPS)', 'Pruebas de penetración', 'Análisis de vulnerabilidades', 'Hacking ético', 'Cámaras de seguridad', 'Control de acceso', 'Alarmas']} />

  <!-- QUÉ HACE CONNEXIS -->
  <section class="section--tight" aria-labelledby="que-hace">
    <div class="wrap summary" data-reveal>
      <h2 id="que-hace" class="summary__q">¿Qué hace ConneXis por su empresa?</h2>
      <p class="lead">ConneXis ofrece soluciones tecnológicas a la medida para pequeñas y medianas empresas de Monterrey y su área metropolitana que necesitan seguridad, conectividad y eficiencia para la continuidad del negocio. Desde redes rápidas y estables hasta ciberseguridad, control de acceso y videovigilancia, somos su socio para construir un entorno digital seguro, funcional y escalable.</p>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section" id="servicios" aria-labelledby="servicios-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Servicios</p>
        <h2 id="servicios-title">Tres áreas para su <span class="hl">infraestructura tecnológica</span></h2>
        <p class="muted">ConneXis cuenta con tres áreas principales de servicio para atender diferentes necesidades de infraestructura tecnológica empresarial.</p>
      </div>
      <ol class="areas">
        {services.map((s, i) => (
          <li class="area">
            <a class="area__link" href={`/servicios/${s.slug}`} data-track="cta_click" data-track-loc={`home-servicio-${s.slug}`}>
              <Photo name={s.image} alt={s.imageAlt} ratio="4/3" sizes="(min-width: 900px) 33vw, 100vw" widths={[400, 640, 900]} />
              <div class="area__body">
                <span class="area__n num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.name}</h3>
                <p>{s.homeText}</p>
                <span class="btn btn--sm btn--ghost area__cta">{s.homeCta} <Icon name="ArrowRight" class="i-arrow" /></span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TABLA: QUÉ RESUELVE CADA SERVICIO -->
  <section class="section--tight" aria-labelledby="tabla-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Comparativa</p>
        <h2 id="tabla-title">Qué resuelve cada servicio</h2>
      </div>
      <div class="table-wrap">
        <table>
          <caption>Servicios de ConneXis, problema que resuelven y entregable</caption>
          <thead><tr><th scope="col">Servicio</th><th scope="col">Problema que resuelve</th><th scope="col">Qué recibe</th></tr></thead>
          <tbody>
            <tr><th scope="row"><a href="/servicios/redes-empresariales">Redes de comunicaciones</a></th><td>Zonas sin Wi‑Fi, caídas, lentitud y una sola red para todo</td><td>Red diseñada, segmentada y escalable</td></tr>
            <tr><th scope="row"><a href="/servicios/ciberseguridad">Ciberseguridad</a></th><td>Virus, accesos indebidos, robo o secuestro de información</td><td>Firewall, IPS, protección de equipos e informe</td></tr>
            <tr><th scope="row"><a href="/servicios/seguridad-electronica">Seguridad electrónica</a></th><td>Áreas sin vigilancia o accesos con llave compartida</td><td>Cámaras de seguridad, alarmas y control de acceso</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* ─────────────────────────────────────────────────────────────────────
     ETAPA 2 · Casos de éxito (proyectos con filtro) y ETAPA 3 · Blog.
     Fuera de alcance en la Etapa 1. Para activarlos, quita este comentario y
     descomenta los imports, `filters`, el <script> y los estilos marcados abajo.
     ─────────────────────────────────────────────────────────────────────
  <!-- PROYECTOS CON FILTRO -->
  <section class="section projects" aria-labelledby="proyectos-title">
    <div class="wrap">
      <div class="projects__head" data-reveal>
        <div>
          <p class="eyebrow">Casos de éxito</p>
          <h2 id="proyectos-title">Proyectos <span class="hl">recientes</span></h2>
        </div>
        <div class="filters" role="group" aria-label="Filtrar proyectos por servicio">
          {filters.map((f, i) => <button type="button" class="filter" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={f.key}>{f.label}</button>)}
        </div>
      </div>
      <ul class="projects__grid" data-projects>
        {cases.map((c, i) => (
          <li data-service={c.service} data-reveal style={`--i:${i}`}>
            <a class="project" href={`/casos-exito/${c.slug}`}>
              <Photo name={c.image} alt={c.imageAlt} sizes="(min-width: 900px) 33vw, 100vw" widths={[400, 640, 900]} ratio="4/3" />
              <div class="project__body">
                <div class="tags"><span class="tag">{c.sector}</span><span class="tag">{c.serviceLabel}</span>{c.ejemplo && <span class="tag tag--lime">Caso de ejemplo</span>}</div>
                <h3>{c.title}</h3>
                <p class="project__res"><Icon name="Check" size={16} /> {c.result}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <p class="sr-only" aria-live="polite" data-filter-status></p>
      <p class="projects__more"><a class="link-arrow" href="/casos-exito">Ver todos los casos <Icon name="ArrowRight" /></a></p>
    </div>
  </section>

  <!-- BLOG / CLUSTER -->
  <section class="section--tight" aria-labelledby="guias-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Guías</p>
        <h2 id="guias-title">Para decidir con información</h2>
      </div>
      <ul class="guides">
        {posts.map((p, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a class="card guide" href={`/blog/${p.slug}`}>
              <span class="tag">{getService(p.pillar).name}</span>
              <h3>{p.h1}</h3>
              <p>{p.excerpt}</p>
              <span class="link-arrow">Leer guía <Icon name="ArrowRight" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  */}

  <!-- NOSOTROS (textos del sitio original de ConneXis) -->
  <section class="section nosotros" id="nosotros" aria-labelledby="nosotros-title">
    <div class="wrap">
      <div class="nos__intro">
        <div>
          <p class="eyebrow">Nosotros</p>
          <h2 id="nosotros-title">¿Quiénes <span class="hl">somos?</span></h2>
        </div>
        <div>
          <p class="lead">Somos un proveedor de soluciones tecnológicas empresariales con presencia en Monterrey y amplia experiencia en el diseño e implementación de soluciones tecnológicas para pequeñas y medianas empresas.</p>
          <p class="muted">Nos especializamos en redes de comunicaciones, seguridad electrónica y ciberseguridad, con servicios integrales que garantizan conectividad, protección y continuidad operativa. En un mundo cada vez más conectado, la tecnología debe ser su mejor aliada: en ConneXis unimos experiencia, innovación y pasión para ayudar al desarrollo y crecimiento de su negocio.</p>
        </div>
      </div>
      <div class="nos__mv">
        <article class="card">
          <span class="icon-chip"><Icon name="Zap" /></span>
          <h3>Nuestra misión</h3>
          <p>Impulsar la productividad de nuestros clientes ayudando a su crecimiento, con soluciones tecnológicas adaptadas a cada negocio, implementadas de manera eficiente y segura.</p>
        </article>
        <article class="card">
          <span class="icon-chip"><Icon name="Radar" /></span>
          <h3>Nuestra visión</h3>
          <p>Ser la empresa de tecnología con enfoque en redes de comunicaciones, seguridad electrónica y ciberseguridad para pequeñas y medianas empresas más reconocida en todo México.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section" id="contacto" aria-labelledby="contacto-title">
    <div class="wrap">
      <div class="diag">
        <div class="diag__copy">
          <p class="eyebrow">Contacto</p>
          <h2 id="contacto-title">Proteja su información <span class="hl">antes de que sea tarde</span></h2>
          <ul class="diag__contact">
            <li><Icon name="Phone" /> <a href={SITE.phoneHref} data-track="click_to_call" data-track-loc="home-form">{SITE.phone}</a></li>
            <li><Icon name="Mail" /> <a href={`mailto:${SITE.email}`} data-track="click_email" data-track-loc="home-form">{SITE.email}</a></li>
            <li><Icon name="WhatsApp" /> <a href={whatsappUrl()} target="_blank" rel="noopener" data-track="click_whatsapp" data-track-loc="home-form">Escribir por WhatsApp<span class="sr-only"> (abre en otra pestaña)</span></a></li>
            <li><Icon name="MapPin" /> <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`} target="_blank" rel="noopener">{fullAddress}<span class="sr-only"> (abre Google Maps)</span></a></li>
            {socialLinks().map((s) => <li><Icon name={s.icon} /> <a href={s.href} target="_blank" rel="noopener" data-track="click_social" data-track-loc={`home-${s.name}`}>{s.name}<span class="sr-only"> (abre en otra pestaña)</span></a></li>)}
          </ul>
        </div>
        <LeadForm id="form-home" variant="mensaje" source="home" title="Formulario de contacto" hideTitle subtitle="Platícanos sobre tu proyecto llenando el formulario y nos pondremos en contacto a la brevedad." submitLabel="Enviar" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(40px, 7vw, 96px) clamp(48px, 7vw, 88px); }
  .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 60% at 80% 40%, rgba(91, 200, 220, 0.08), transparent 70%), linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px) 0 0 / 48px 48px, linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px) 0 0 / 48px 48px; mask: radial-gradient(80% 80% at 60% 40%, #000 30%, transparent 80%); -webkit-mask: radial-gradient(80% 80% at 60% 40%, #000 30%, transparent 80%); pointer-events: none; }
  .hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 32px; align-items: center; }
  .hero h1 { max-width: 15ch; }
  .hero h1 .hl { display: inline; }
  .hero .lead { margin: 24px 0 32px; }
  .hero__proof { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 32px; color: var(--muted); font-size: 0.92rem; }
  .hero__proof li { display: inline-flex; gap: 8px; align-items: center; }
  .hero__proof :global(svg) { color: var(--lime); }
  .hero__radar { display: grid; place-items: center; margin-right: calc(var(--gutter) * -1); }
  /* La entrada del hero la anima Motion (src/scripts/motion.ts). */
  @media (max-width: 899px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero { padding-top: 24px; }
    .hero__radar { order: -1; margin: 0 auto -8px; }
    .hero__radar :global(.radar) { --size: 150px; }
    .hero .lead { margin: 16px 0 24px; }
  }

  .summary { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: clamp(24px, 5vw, 72px); align-items: start; }
  .summary__q { font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .summary .lead { margin: 0; color: var(--text); }
  @media (max-width: 899px) { .summary { grid-template-columns: 1fr; } }

  .areas { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .area__link { display: flex; flex-direction: column; height: 100%; text-decoration: none; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); overflow: hidden; transition: border-color 0.3s, transform 0.4s var(--ease); }
  .area__link:hover { border-color: var(--line-strong); transform: translateY(-3px); }
  .area__link :global(.photo) { border-radius: 0; }
  .area__body { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: clamp(20px, 2.4vw, 28px); flex: 1; }
  .area__n { color: var(--lime); font-size: 0.85rem; font-weight: 600; }
  .area h3 { margin: 0; font-size: clamp(1.25rem, 1.8vw, 1.5rem); }
  .area p { margin: 0 0 8px; color: var(--muted); }
  .area__cta { margin-top: auto; white-space: normal; text-align: left; }
  .area__link:hover .area__cta { border-color: var(--lime); color: var(--lime); }
  @media (max-width: 899px) { .areas { grid-template-columns: 1fr; } }

  .nos__intro { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: clamp(24px, 5vw, 80px); align-items: end; margin-bottom: clamp(32px, 4vw, 56px); }
  .nos__intro h2 { margin: 0; }
  .nos__intro .lead { color: var(--text); margin-bottom: 16px; }
  .nos__mv { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .nos__mv p { font-size: 1.02rem; }
  @media (max-width: 899px) { .nos__intro, .nos__mv { grid-template-columns: 1fr; } }

  /* ETAPA 2 · Proyectos con filtro y ETAPA 3 · Guías del blog (fuera de alcance en la Etapa 1)
  .projects__head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 32px; }
  .projects__head h2 { margin: 0; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter { min-height: 40px; padding: 8px 16px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent; cursor: pointer; font-size: 0.9rem; color: var(--muted); transition: all 0.2s; }
  .filter:hover { color: var(--text); border-color: var(--muted); }
  .filter[aria-pressed='true'] { background: var(--lime); border-color: var(--lime); color: var(--lime-ink); font-weight: 600; }
  .projects__grid { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .projects__grid li[hidden] { display: none; }
  .project { display: block; text-decoration: none; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface); height: 100%; transition: border-color 0.3s, transform 0.4s var(--ease); }
  .project:hover { border-color: var(--line-strong); transform: translateY(-3px); }
  .project :global(.photo) { border-radius: 0; }
  .project__body { padding: 20px; display: grid; gap: 12px; }
  .project h3 { margin: 0; }
  .project__res { margin: 0; display: flex; gap: 8px; align-items: flex-start; color: var(--lime); font-size: 0.92rem; }
  .project__res :global(svg) { flex: none; margin-top: 4px; }
  .projects__more { margin-top: 24px; }
  @media (max-width: 899px) { .projects__grid { grid-template-columns: 1fr; } }

  .guides { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .guide { height: 100%; display: flex !important; flex-direction: column; gap: 12px; align-items: flex-start; }
  .guide h3 { margin: 4px 0 0; }
  .guide .link-arrow { margin-top: auto; }
  @media (max-width: 899px) { .guides { grid-template-columns: 1fr; } }

  */

  .diag { display: grid; grid-template-columns: 1fr minmax(0, 460px); gap: clamp(32px, 5vw, 80px); align-items: start; padding: clamp(24px, 5vw, 56px); border-radius: 20px; border: 1px solid var(--line); background: radial-gradient(70% 90% at 100% 0%, rgba(140, 211, 54, 0.12), transparent 60%), var(--bg-2); }
  .diag__copy h2 { margin-bottom: 28px; }
  .diag__contact { list-style: none; display: grid; gap: 14px; }
  .diag__contact li { display: grid; grid-template-columns: 22px 1fr; gap: 12px; color: var(--muted); }
  .diag__contact a { color: var(--text); text-decoration: none; }
  .diag__contact a:hover { text-decoration: underline; }
  .diag__contact :global(svg) { color: var(--lime); margin-top: 3px; }
  @media (max-width: 899px) { .diag { grid-template-columns: 1fr; } }
</style>

<script>
  // ETAPA 2 · Filtro de proyectos (descomentar junto con la sección de casos de éxito)
  /*
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-projects] > li');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const key = b.dataset.filter;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    let shown = 0;
