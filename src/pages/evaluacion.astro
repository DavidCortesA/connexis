---
// Landing para Google Ads: un solo objetivo (pedir la evaluación).
// Sin menú de navegación, formulario de 4 campos visible sin scroll y, en móvil, justo después del titular.
// noindex para no competir con /servicios/ciberseguridad en orgánico.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import { SITE, whatsappUrl } from '../data/site';
import { mentionOnly } from '../data/services';

const faqs = [
  { q: '¿Cuánto dura la evaluación?', a: 'Para una PyME suele tomar de 3 a 10 días hábiles, según el número de equipos y sucursales.' },
  { q: '¿Afecta la operación de mi empresa?', a: 'No. Las revisiones se programan en horarios acordados y las pruebas más intrusivas solo se hacen con su autorización.' },
  { q: '¿Qué pasa con la información que revisan?', a: 'Se trata de forma confidencial y solo se usa para elaborar su informe, conforme a nuestro aviso de privacidad.' },
  { q: '¿Qué pasa después del informe?', a: 'Le explicamos los hallazgos y, si lo desea, le proponemos un plan por etapas para corregirlos.' },
];
const deliverables = [
  { icon: 'FileSearch', title: 'Informe de hallazgos', text: 'Vulnerabilidades encontradas en sistemas, aplicaciones y dispositivos.' },
  { icon: 'ListChecks', title: 'Prioridades', text: 'Cada hallazgo clasificado por riesgo: crítico, alto, medio o bajo.' },
  { icon: 'BrickWall', title: 'Revisión perimetral', text: 'Estado de su firewall, accesos remotos y puertos expuestos.' },
  { icon: 'ClipboardCheck', title: 'Recomendaciones claras', text: 'Qué corregir primero, explicado en lenguaje de negocio.' },
] as const;
---
<BaseLayout
  title="Evaluación de ciberseguridad para empresas en Monterrey"
  description="Descubra los puntos débiles de su red antes que los atacantes. Evaluación de ciberseguridad con informe claro y recomendaciones priorizadas."
  shareTitle="Evaluación de ciberseguridad para su empresa · ConneXis"
  noindex
  variant="landing"
  faqs={faqs}
  mobileCta={{ href: '#form-evaluacion', label: 'Solicitar' }}
>
  <section class="lp-hero" aria-labelledby="lp-title">
    <div class="wrap lp-grid">
      <div class="lp-copy" data-hero>
        <p class="eyebrow">Evaluación de ciberseguridad</p>
        <h1 id="lp-title">Evaluación de ciberseguridad para su empresa</h1>
        <p class="lead">Descubra antes que los atacantes dónde están los puntos débiles de su red, con un informe claro y recomendaciones prácticas.</p>
      </div>
      <div class="lp-form">
        <LeadForm id="form-evaluacion" source="landing-evaluacion" service="Evaluación de ciberseguridad" title="Solicite su evaluación" subtitle="Solo 4 datos." submitLabel="Quiero mi evaluación" />
      </div>
      <div class="lp-more">
        <ul class="checks">
          <li><Icon name="CircleCheck" /> Análisis de vulnerabilidades en sistemas, aplicaciones y dispositivos.</li>
          <li><Icon name="CircleCheck" /> Revisión de su firewall, accesos y protección de equipos.</li>
          <li><Icon name="CircleCheck" /> Informe con recomendaciones priorizadas, en lenguaje claro.</li>
        </ul>
        <ul class="badges">
          <li><Icon name="MapPin" size={16} /> <strong>Monterrey</strong> · atención en sitio</li>
          <li><Icon name="Users" size={16} /> <strong>PyMEs</strong> · oficinas e industrias</li>
          <li><Icon name="Clock" size={16} /> Respuesta en <strong>{SITE.responseTime}</strong></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="lp-entregables">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Qué recibe</p>
        <h2 id="lp-entregables">Entregables de la evaluación</h2>
      </div>
      <ul class="grid g4">
        {deliverables.map((d, i) => (
          <li class="card" data-reveal style={`--i:${i}`}><span class="icon-chip"><Icon name={d.icon} /></span><h3>{d.title}</h3><p>{d.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="lp-pasos">
    <div class="wrap">
      <div class="steps-head" data-reveal>
        <div>
          <p class="eyebrow">Cómo funciona</p>
          <h2 id="lp-pasos">Tres pasos, sin complicaciones</h2>
        </div>
        <a class="link-arrow" href="#form-evaluacion">Solicitar evaluación <Icon name="ArrowRight" /></a>
      </div>
      <ol class="grid g3">
        <li class="card" data-reveal><span class="tag tag--lime">Paso 1</span><h3>Le contactamos</h3><p>Confirmamos el alcance: equipos, sucursales y horarios.</p></li>
        <li class="card" data-reveal style="--i:1"><span class="tag tag--lime">Paso 2</span><h3>Evaluamos</h3><p>Revisamos su red de forma remota y en sitio, sin detener la operación.</p></li>
        <li class="card" data-reveal style="--i:2"><span class="tag tag--lime">Paso 3</span><h3>Recibe su informe</h3><p>Le explicamos los hallazgos y qué corregir primero.</p></li>
      </ol>
      <p class="also">Además de ciberseguridad, ConneXis instala redes empresariales, seguridad electrónica, {mentionOnly.map((m) => m.name.toLowerCase()).join(' y ')}.</p>
    </div>
  </section>

  <Faq faqs={faqs} title="Antes de solicitarla" intro="¿Otra duda?" />

  <section class="section--tight" aria-labelledby="lp-final">
    <div class="wrap">
      <div class="lp-final" data-reveal>
        <div>
          <h2 id="lp-final">Proteja su información antes de que sea demasiado tarde</h2>
          <p class="muted">La evaluación es el primer paso para invertir donde está el riesgo real.</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--light" href="#form-evaluacion">Solicitar evaluación</a>
          <a class="btn btn--wa" href={whatsappUrl('Hola ConneXis, quiero una evaluación de ciberseguridad.')} target="_blank" rel="noopener" data-track="click_whatsapp" data-track-loc="landing-final"><Icon name="WhatsApp" /> WhatsApp<span class="sr-only"> (abre en otra pestaña)</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lp-hero { padding-block: clamp(28px, 5vw, 64px); background: radial-gradient(50% 70% at 0% 0%, rgba(91, 200, 220, 0.08), transparent 70%); }
  .lp-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 440px); grid-template-areas: 'copy form' 'more form'; gap: 8px clamp(32px, 6vw, 80px); align-items: start; }
  .lp-copy { grid-area: copy; }
  .lp-form { grid-area: form; }
  .lp-more { grid-area: more; }
  .lp-copy h1 { font-size: clamp(2.1rem, 4.6vw, 3.6rem); }
  .lp-copy .lead { margin: 18px 0 8px; }
  .checks { list-style: none; display: grid; gap: 12px; margin: 16px 0 24px; }
  .checks li { display: grid; grid-template-columns: 22px 1fr; gap: 12px; color: var(--muted); }
  .checks :global(svg) { color: var(--lime); margin-top: 3px; }
  .badges { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .badges li { display: inline-flex; gap: 8px; align-items: center; padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; font-size: 0.88rem; color: var(--muted); background: var(--surface); }
  .badges strong { color: var(--text); font-weight: 600; }
  .badges :global(svg) { color: var(--lime); }
  @media (max-width: 899px) {
    .lp-grid { grid-template-columns: 1fr; grid-template-areas: 'copy' 'form' 'more'; gap: 20px; }
  }
  .grid { list-style: none; }
  .g4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .g3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .g3 .tag { margin-bottom: 14px; }
  @media (max-width: 1023px) { .g4 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) { .g4, .g3 { grid-template-columns: 1fr; } }
  .steps-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .steps-head h2 { margin: 0; }
  .also { margin-top: 28px; color: var(--faint); font-size: 0.92rem; }
  .lp-final { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding: clamp(24px, 4vw, 44px); border-radius: 20px; border: 1px solid var(--line); background: linear-gradient(135deg, #141a20, #0f1418); }
  .lp-final h2 { font-size: clamp(1.5rem, 2.6vw, 2.2rem); max-width: 22ch; }
  .lp-final p { margin: 0; }
</style>
