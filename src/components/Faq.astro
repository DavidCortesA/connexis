---
// Preguntas frecuentes accesibles con <details>. El schema FAQPage lo agrega el layout
// (prop `faqs`) para que viva en el mismo @graph que el resto de datos estructurados.
import Icon from './Icon.astro';
import type { Faq } from '../data/services';
import { SITE, whatsappUrl } from '../data/site';
interface Props { faqs: Faq[]; title?: string; intro?: string; id?: string }
const { faqs, title = 'Preguntas frecuentes', intro, id = 'preguntas-frecuentes' } = Astro.props;
---
<section class="section faq" aria-labelledby={`${id}-h`} id={id}>
  <div class="wrap faq__grid">
    <div class="faq__intro" data-reveal>
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 id={`${id}-h`}>{title}</h2>
      <p class="muted">{intro ?? '¿Tiene otra pregunta?'} <a class="link-arrow" href={whatsappUrl('Hola ConneXis, tengo una pregunta.')} target="_blank" rel="noopener" data-track="click_whatsapp" data-track-loc="faq">Escríbanos por WhatsApp<span class="sr-only"> (abre en otra pestaña)</span></a></p>
    </div>
    <div class="faq__list">
      {faqs.map((f, i) => (
        <details class="faq__item" open={i === 0} data-reveal style={`--i:${i}`}>
          <summary><h3>{f.q}</h3><Icon name="ChevronDown" size={20} class="faq__chev" /></summary>
          <div class="faq__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq__intro { position: sticky; top: calc(var(--header-h) + 32px); }
  .faq__list { display: grid; gap: 10px; }
  .faq__item { border: 1px solid var(--line); border-radius: 12px; background: var(--surface); transition: border-color 0.3s; }
  .faq__item[open] { border-color: rgba(140, 211, 54, 0.45); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 20px; border-radius: 12px; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 1.05rem; font-weight: 600; }
  summary :global(.faq__chev) { flex: none; color: var(--lime); transition: transform 0.3s var(--ease); }
  details[open] summary :global(.faq__chev) { transform: rotate(180deg); }
  .faq__a { padding: 0 20px 18px; color: var(--muted); }
  .faq__a p { margin: 0; }
  @media (max-width: 899px) { .faq__grid { grid-template-columns: 1fr; } .faq__intro { position: static; } }
</style>
