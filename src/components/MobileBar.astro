---
// CTA fija en móvil: llamada como acción principal + WhatsApp + formulario.
// En escritorio se muestra solo el botón flotante de WhatsApp.
import Icon from './Icon.astro';
import { SITE, whatsappUrl } from '../data/site';
interface Props { ctaHref?: string; ctaLabel?: string }
const { ctaHref = '/contacto', ctaLabel = 'Contactar' } = Astro.props;
---
<nav class="mbar" aria-label="Contacto rápido">
  <a class="mbar__call" href={SITE.phoneHref} data-track="click_to_call" data-track-loc="barra-movil">
    <Icon name="Phone" size={20} /> <span>Llamar ahora</span>
  </a>
  <a class="mbar__wa" href={whatsappUrl()} target="_blank" rel="noopener" data-track="click_whatsapp" data-track-loc="barra-movil">
    <Icon name="WhatsApp" size={22} /><span class="sr-only">Escribir por WhatsApp (abre en otra pestaña)</span>
  </a>
  <a class="mbar__cta" href={ctaHref} data-track="cta_click" data-track-loc="barra-movil">{ctaLabel}</a>
</nav>
<a class="wa-fab" href={whatsappUrl()} target="_blank" rel="noopener" data-track="click_whatsapp" data-track-loc="flotante">
  <Icon name="WhatsApp" size={26} /><span class="sr-only">Escribir por WhatsApp (abre en otra pestaña)</span>
</a>

<style>
  .mbar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; display: none;
    grid-template-columns: 1fr 56px 1fr; gap: 8px; align-items: center;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: rgba(10, 13, 16, 0.94);
    border-top: 1px solid var(--line); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  .mbar a { min-height: 50px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 600; text-decoration: none; font-size: 0.98rem; }
  .mbar__call { background: var(--lime); color: var(--lime-ink); }
  .mbar__wa { background: var(--wa); color: #04210f; }
  .mbar__cta { border: 1px solid var(--line-strong); color: var(--text); }
  .wa-fab {
    position: fixed; right: 24px; bottom: 24px; z-index: 90; width: 58px; height: 58px; border-radius: 50%;
    display: grid; place-items: center; background: var(--wa); color: #04210f; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    transition: transform 0.3s var(--ease);
  }
  .wa-fab:hover { transform: scale(1.06); }
  @media (max-width: 899px) { .mbar { display: grid; } .wa-fab { display: none; } }
</style>
