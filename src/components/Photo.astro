---
// Imagen optimizada (AVIF/WebP, srcset) con tratamiento en blanco y negro de la propuesta.
import { Picture } from 'astro:assets';
import { img } from '../data/images';
interface Props { name: string; alt: string; widths?: number[]; sizes?: string; class?: string; eager?: boolean; tint?: boolean; ratio?: string }
const { name, alt, widths = [480, 768, 1080, 1440], sizes = '(min-width: 1100px) 50vw, 100vw', class: cls, eager = false, tint = false, ratio } = Astro.props;
const src = img(name);
---
<div class:list={['photo', { 'photo--tint': tint }, cls]} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  <Picture src={src} alt={alt} widths={widths} sizes={sizes} formats={['webp']} fallbackFormat="jpg" quality={70}
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding={eager ? 'sync' : 'async'} />
</div>
