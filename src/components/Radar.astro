---
// Radar animado con el isotipo al centro (dirección visual de la propuesta "Operación").
import { ISO_D } from '../data/brand-paths';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class:list={['radar', cls]} aria-hidden="true">
  <svg viewBox="0 0 600 600" class="radar__grid">
    <defs>
      <radialGradient id="rg-fade" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#8CD336" stop-opacity="0.10" />
        <stop offset="1" stop-color="#8CD336" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="rg-iso" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#5BC8DC" /><stop offset="1" stop-color="#1E6CC4" /></linearGradient>
    </defs>
    <circle cx="300" cy="300" r="290" fill="url(#rg-fade)" />
    {[290, 230, 170, 110].map((r) => <circle cx="300" cy="300" r={r} fill="none" stroke="#8CD336" stroke-opacity="0.18" />)}
    <line x1="10" y1="300" x2="590" y2="300" stroke="#8CD336" stroke-opacity="0.12" />
    <line x1="300" y1="10" x2="300" y2="590" stroke="#8CD336" stroke-opacity="0.12" />
    {Array.from({ length: 72 }).map((_, i) => {
      const a = (i * 5 * Math.PI) / 180; const r1 = i % 6 === 0 ? 276 : 284;
      return <line x1={300 + Math.cos(a) * r1} y1={300 + Math.sin(a) * r1} x2={300 + Math.cos(a) * 290} y2={300 + Math.sin(a) * 290} stroke="#8CD336" stroke-opacity="0.35" />;
    })}
  </svg>
  <div class="radar__sweep"></div>
  <span class="blip" style="--x:72%;--y:30%;--d:0.2s"></span>
  <span class="blip" style="--x:28%;--y:66%;--d:1.1s"></span>
  <span class="blip blip--warn" style="--x:63%;--y:74%;--d:2.3s"></span>
  <span class="blip" style="--x:35%;--y:24%;--d:3.1s"></span>
  <div class="radar__core">
    <svg viewBox="346 201 610 610"><path fill="url(#rg-iso)" d={ISO_D} /></svg>
  </div>
</div>

<style>
  .radar { --size: min(560px, 88vw); position: relative; width: var(--size); aspect-ratio: 1; }
  .radar__grid { position: absolute; inset: 0; width: 100%; height: 100%; }
  .radar__sweep {
    position: absolute; inset: 1.6%; border-radius: 50%;
    background: conic-gradient(from 0deg, rgba(140, 211, 54, 0.38), rgba(140, 211, 54, 0.08) 40deg, transparent 90deg);
    mask: radial-gradient(circle, #000 98%, transparent 100%);
    -webkit-mask: radial-gradient(circle, #000 98%, transparent 100%);
    animation: sweep 4s linear infinite;
  }
  @keyframes sweep { to { transform: rotate(360deg); } }
  .radar__core {
    position: absolute; left: 50%; top: 50%; width: 22%; aspect-ratio: 1; transform: translate(-50%, -50%);
    border-radius: 50%; display: grid; place-items: center; background: var(--bg);
    box-shadow: 0 0 0 2px rgba(140, 211, 54, 0.8), 0 0 0 10px rgba(140, 211, 54, 0.08), 0 0 60px rgba(91, 200, 220, 0.25);
  }
  .radar__core svg { width: 62%; }
  .blip { position: absolute; left: var(--x); top: var(--y); width: 10px; height: 10px; margin: -5px; border-radius: 50%; background: var(--lime); opacity: 0; animation: blip 4s var(--d) ease-out infinite; }
  .blip::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--lime); animation: inherit; }
  .blip--warn { background: var(--cyan); }
  .blip--warn::after { border-color: var(--cyan); }
  @keyframes blip { 0% { opacity: 0; transform: scale(0.6); } 6% { opacity: 1; transform: scale(1); } 60% { opacity: 0.15; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .radar__sweep { animation: none; transform: rotate(35deg); } .blip { animation: none; opacity: 0.8; } }
</style>
