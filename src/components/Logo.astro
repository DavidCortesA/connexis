---
// Logo horizontal construido con los trazos originales (isotipo + wordmark del logo oscuro).
import { ISO_D, CONNE_D, XIS_D, DOT_D } from '../data/brand-paths';
interface Props { class?: string; height?: number; idSuffix?: string }
const { class: cls, height = 30, idSuffix = 'h' } = Astro.props;
const gid = `cx-g-${idSuffix}`;
const width = Math.round((866 / 130) * height);
---
<svg class={cls} width={width} height={height} viewBox="0 0 866 130" role="img" aria-label="ConneXis">
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#5BC8DC" /><stop offset="1" stop-color="#1E6CC4" /></linearGradient>
  </defs>
  <g transform="scale(0.2131) translate(-346 -201)"><path fill={`url(#${gid})`} d={ISO_D} /></g>
  <g transform="translate(-164 -845)">
    <path fill="#8CD336" d={CONNE_D} />
    <path fill="#FFFFFF" d={XIS_D} />
    <path fill={`url(#${gid})`} d={DOT_D} />
  </g>
</svg>
