---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import Seo, { type Crumb } from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import ShareButton from '../components/ShareButton.astro';
import type { Faq } from '../data/services';
import { SITE } from '../data/site';
import saira from '@fontsource-variable/saira/files/saira-latin-wght-normal.woff2?url';

export interface Props {
  title: string;
  description: string;
  /** Texto para compartir (por defecto, el H1 de la página). */
  shareTitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  breadcrumbs?: Crumb[];
  faqs?: Faq[];
  schema?: Record<string, unknown>[];
  article?: { published: string; updated: string; section?: string };
  variant?: 'default' | 'landing';
  mobileCta?: { href: string; label: string };
  showShare?: boolean;
}
const { variant = 'default', shareTitle, mobileCta, showShare = true, ...seo } = Astro.props;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { if (sessionStorage.getItem('cx-loaded')) document.documentElement.classList.add('cx-skip-loader'); } catch (e) {}
    </script>
    <Seo {...seo} />
    <meta name="theme-color" content="#0A0D10" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={saira} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="scroll-progress" data-progress aria-hidden="true"></div>
    <Loader />
    <Header variant={variant} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    {showShare && (
      <aside class="share-band" aria-label="Compartir">
        <div class="wrap share-band__in">
          <p>¿Le sirvió esta página? Compártala con su equipo.</p>
          <ShareButton title={shareTitle ?? seo.title} />
        </div>
      </aside>
    )}
    <Footer variant={variant} />
    <MobileBar ctaHref={mobileCta?.href} ctaLabel={mobileCta?.label} />
    <CookieBanner />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
  .share-band { border-top: 1px solid var(--line); }
  .share-band__in { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 20px; flex-wrap: wrap; }
  .share-band p { margin: 0; color: var(--muted); font-size: 0.95rem; }
</style>
